# Copy to .env and fill in from your Supabase project settings (Project Settings -> API).
# EXPO_PUBLIC_ vars are inlined into the JS bundle, so use the anon key only - never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
