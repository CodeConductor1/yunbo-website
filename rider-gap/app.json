{
  "expo": {
    "name": "Rider Gap",
    "slug": "rider-gap",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ridergap.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rider Gap uses your location to measure how far ahead or behind you are on the route."
      }
    },
    "android": {
      "package": "com.ridergap.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rider Gap uses your location to measure how far ahead or behind you are on the route."
        }
      ]
    ]
  }
}
